{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for all windows",
  "windows": [
    "main",
    "excalidraw-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "global-shortcut:default",
    "global-shortcut:allow-register-all",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",
    {
      "identifier": "core:event:allow-listen",
      "allow": [
        {
          "windows": ["main", "excalidraw-*"]
        }
      ]
    },
    {
      "identifier": "core:window:allow-set-title",
      "allow": [
        {
          "windows": ["main", "excalidraw-*"]
        }
      ]
    },
    {
      "identifier": "core:window:allow-destroy",
      "allow": [
        {
          "windows": ["main", "excalidraw-*"]
        }
      ]
    },
    {
      "identifier": "core:window:allow-close",
      "allow": [
        {
          "windows": ["main", "excalidraw-*"]
        }
      ]
    }
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ]
}
