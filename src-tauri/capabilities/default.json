{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for all windows",
  "windows": [
    "main",
    "excalidraw-*",
    "settings"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "global-shortcut:default",
    "global-shortcut:allow-register-all",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",
    "window-state:default",
    {
      "identifier": "core:event:allow-listen",
      "allow": [
        {
          "windows": [
            "main",
            "excalidraw-*",
            "settings"
          ]
        }
      ]
    },
    {
      "identifier": "core:window:allow-set-title",
      "allow": [
        {
          "windows": [
            "main",
            "excalidraw-*",
            "settings"
          ]
        }
      ]
    },
    {
      "identifier": "core:window:allow-destroy",
      "allow": [
        {
          "windows": [
            "main",
            "excalidraw-*",
            "settings"
          ]
        }
      ]
    },
    {
      "identifier": "core:window:allow-close",
      "allow": [
        {
          "windows": [
            "main",
            "excalidraw-*",
            "settings"
          ]
        }
      ]
    },
    {
      "identifier": "core:window:allow-show",
      "allow": [
        {
          "windows": [
            "main",
            "excalidraw-*",
            "settings"
          ]
        }
      ]
    },
    {
      "identifier": "core:window:allow-set-focus",
      "allow": [
        {
          "windows": [
            "main",
            "excalidraw-*",
            "settings"
          ]
        }
      ]
    },
    "store:default",
    "notification:default"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ]
}
